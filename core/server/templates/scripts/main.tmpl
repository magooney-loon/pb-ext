{{define "scripts"}}

<script>


    function showPocketBaseElements() {
        // Show elements that should only appear when PocketBase styles are loaded
        document.querySelectorAll('.pb-piggybacked-only').forEach(el => {
            el.style.display = 'inline-flex';
        });
    }

    // The sidebar tabs, in order.
    //
    // Everything below is driven by this list, so adding a tab means adding one
    // entry here and a matching nav item and section in index.tmpl. The wiring
    // used to be spelled out per tab in five separate places — the declarations,
    // the guard, the switch, the initial hash and the hashchange handler — which
    // is four opportunities for a new tab to be half-registered.
    //
    // onShow names a global loader called each time the tab is displayed; the
    // functions themselves are idempotent.
    const DASHBOARD_TABS = [
        { name: 'health',    tab: '.health-tab',    section: 'health-section' },
        { name: 'analytics', tab: '.analytics-tab', section: 'analytics-section' },
        { name: 'alerts',    tab: '.alerts-tab',    section: 'alerts-section' },
        { name: 'api',       tab: '.api-tab',       section: 'api-section' },
        { name: 'cron',      tab: '.cron-tab',      section: 'cron-section', onShow: 'initializeCronJobs' },
        { name: 'rules',     tab: '.rules-tab',     section: 'rules-section', onShow: 'initializeRules' },
    ];

    const DEFAULT_TAB = 'health';

    function setupTabNavigation() {
        const tabs = DASHBOARD_TABS.map(function(def) {
            return {
                name: def.name,
                onShow: def.onShow,
                el: document.querySelector(def.tab),
                section: document.getElementById(def.section),
            };
        });

        // If any tab or section is missing, leave navigation alone: a
        // half-wired sidebar hides content with no way to reach it.
        if (tabs.some(function(t) { return !t.el || !t.section; })) return;

        function switchToTab(name) {
            const target = tabs.find(function(t) { return t.name === name; })
                || tabs.find(function(t) { return t.name === DEFAULT_TAB; });

            tabs.forEach(function(t) {
                t.el.classList.remove('current-route');
                t.section.style.display = 'none';
            });

            target.el.classList.add('current-route');
            target.section.style.display = 'block';
            window.location.hash = target.name;

            if (target.onShow && typeof window[target.onShow] === 'function') {
                window[target.onShow]();
            }
        }

        function tabFromHash() {
            const name = window.location.hash.replace(/^#/, '');
            return tabs.some(function(t) { return t.name === name; }) ? name : DEFAULT_TAB;
        }

        switchToTab(tabFromHash());

        tabs.forEach(function(t) {
            t.el.addEventListener('click', function(e) {
                e.preventDefault();
                switchToTab(t.name);
            });
        });

        // Browser back/forward.
        window.addEventListener('hashchange', function() {
            switchToTab(tabFromHash());
        });
    }

    window.onload = () => {
        // Show content once loaded
        const contentEl = document.getElementById('content');
        if (contentEl) {
            contentEl.style.opacity = '1';
        }

        // Setup tab navigation
        setupTabNavigation();

        // If body has the pb-piggybacked class, enable PocketBase-specific elements
        if (document.body.classList.contains('pb-styled')) {
            showPocketBaseElements();
        }

        // Also set up a MutationObserver to detect if the class is added later
        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                    if (document.body.classList.contains('pb-styled')) {
                        showPocketBaseElements();
                        observer.disconnect(); // No need to observe anymore
                    }
                }
            });
        });

        observer.observe(document.body, { attributes: true });
    };
</script>
{{end}}
